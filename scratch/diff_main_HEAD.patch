+func humanizeDurationShort(d time.Duration) string {
+	sec := int(d.Seconds())
+	if sec < 60 {
+		return "now"
+	}
+	min := sec / 60
+	if min < 60 {
+		return plural(min, "min")
+	}
+	hr := min / 60
+	if hr < 24 {
+		return plural(hr, "hour")
+	}
+	day := hr / 24
+	return plural(day, "day")
+}
+
+func plural(n int, unit string) string {
+	if n == 1 {
+		return "1 " + unit
+	}
+	return fmt.Sprintf("%d %ss", n, unit)
+}
