+	if el, ok := hlIndex[key]; ok {
+		hlList.MoveToFront(el)
+		return el.Value.(hlEntry).value, true
+	}
+	return "", false
+}
+
+func hlPut(key, value string) {
+	if el, ok := hlIndex[key]; ok {
+		el.Value = hlEntry{key: key, value: value}
+		hlList.MoveToFront(el)
